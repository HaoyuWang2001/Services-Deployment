{
  "name": "k8s-0-mooncake-compile",
  "description": "复用一台已启动的编译容器完成 Mooncake 编译：容器内拉取指定分支/commit 代码（git config 注入代理）、注入并执行编译脚本、将产物 docker cp 到宿主机 ARTIFACT_DST（保留 mooncake-<commit>-<arch> 目录层级）。不新建、不删除容器，因此容器内的 build 缓存与 Go 依赖可跨次复用。独立流程，不走 push-lab.sh。",
  "nodes": [
    "node4-compile"
  ],
  "workspace": "/home/haoyu/k8s-ws/k8s-0-mooncake-compile",
  "start": {
    "script": "run-compile.sh",
    "args": [],
    "log": "k8s-0-mooncake-compile.log"
  },
  "stop": {
    "script": "stop-compile.sh",
    "timeout": 10
  },
  "deploy": {
    "files": [
      "run-compile.sh",
      "stop-compile.sh",
      "build-mooncake.sh",
      "build-mooncake-with-kvtest.sh"
    ]
  },
  "variables": {
    "CONTAINER_NAME": "mooncake-compile",
    "REPO_DIR": "/workspace/Mooncake",
    "GIT_BRANCH": "",
    "COMMIT_ID": "",
    "BUILD_SCRIPT": "build-mooncake.sh",
    "SCRIPT_DEST_DIR": "/workspace",
    "PROXY_IP": "",
    "PROXY_PORT": "3128",
    "CLEAN_BUILD": "false",
    "VENV": "",
    "ARTIFACT_DST": ""
  },
  "allow_duplicate_start": false
}