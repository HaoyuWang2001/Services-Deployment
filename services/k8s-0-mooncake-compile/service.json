{
  "name": "k8s-0-mooncake-compile",
  "description": "自起编译容器（COMPILE_IMAGE:COMPILE_IMAGE_TAG）完成 Mooncake 编译：容器内拉取指定分支/commit 代码（git config 注入代理）、注入并执行编译脚本（脚本随服务部署到服务目录，由 BUILD_SCRIPT 选择）、将编译产物 docker cp 到容器外 ARTIFACT_DST，最后完全关闭并删除编译容器。独立流程，不走 push-lab.sh。",
  "nodes": [
    "node4-compile"
  ],
  "workspace": "/home/haoyu/k8s-ws/k8s-0-mooncake-compile",
  "start": {
    "script": "run-compile.sh",
    "args": [],
    "log": "k8s-0-mooncake-compile.log"
  },
  "stop": {
    "script": "stop-compile.sh",
    "timeout": 10
  },
  "deploy": {
    "files": [
      "run-compile.sh",
      "stop-compile.sh",
      "build-mooncake.sh",
      "build-mooncake-with-kvtest.sh"
    ]
  },
  "variables": {
    "COMPILE_IMAGE": "mooncake-compile-w00921547-base",
    "COMPILE_IMAGE_TAG": "latest",
    "CONTAINER_NAME": "mooncake-compile-w00921547",
    "REPO_DIR": "/workspace/Mooncake",
    "GIT_BRANCH": "",
    "COMMIT_ID": "",
    "BUILD_SCRIPT": "build-mooncake.sh",
    "SCRIPT_DEST_DIR": "/workspace",
    "PROXY_IP": "",
    "PROXY_PORT": "3128",
    "CLEAN_BUILD": "true",
    "VENV": "",
    "ARTIFACT_DST": ""
  },
  "allow_duplicate_start": false
}
