{
  "name": "k8s-1-mooncake-build-image",
  "description": "从编译容器内产物根目录（ARTIFACT_DIR + COMMIT_ID 拼出 mooncake-<commit>-<arch>-linux）流式直传到 runtime 容器，打包镜像（含 whl 安装与校验）并导出 tar",
  "nodes": [],
  "workspace": "",
  "start": {
    "script": "build-mooncake-runtime-image.sh",
    "args": [],
    "log": "k8s-1-mooncake-build-image.log"
  },
  "stop": {
    "timeout": 10
  },
  "deploy": {
    "files": [
      "build-mooncake-runtime-image.sh",
      "check-mooncake-ldd.sh",
      "check-mooncake-wheel.sh"
    ]
  },
  "variables": {
    "COMPILE_CONTAINER": "mooncake-compile",
    "ARTIFACT_DIR": "",
    "COMMIT_ID": "",
    "BASE_IMAGE": "mooncake-runtime-w00921547-base:latest",
    "PROXY_IP": "",
    "PROXY_PORT": "3128",
    "TAR_OUTPUT_DIR": ""
  },
  "allow_duplicate_start": false
}
